{
  "id": "newbie-plains",
  "name": "新手平原",
  "version": 1,
  "design_reference": "俯視角、自然拼接、大地標、探索導向；不複製其他遊戲素材",
  "tileSize": 640,
  "grid": { "columns": 6, "rows": 6, "coordinateOrigin": "top-left" },
  "worldSize": { "width": 3840, "height": 3840 },
  "layers": [
    { "id": "terrain", "z": 10, "required": true, "description": "草地、泥土、土坡、石地等不可透明的地面" },
    { "id": "water", "z": 20, "required": false, "description": "河流、湖泊與岸線；水體邊界必須連續" },
    { "id": "paths", "z": 30, "required": false, "description": "道路、小徑、橋；道路可跨 Tile" },
    { "id": "nature", "z": 40, "required": false, "description": "樹、灌木、岩石、花草；透明背景" },
    { "id": "buildings", "z": 50, "required": false, "description": "房屋、商店、訓練場、農舍等；透明背景" },
    { "id": "objects", "z": 60, "required": false, "description": "圍欄、路牌、箱子、井、燈等；透明背景" },
    { "id": "npcs", "z": 70, "required": false, "description": "NPC 與可互動角色，由程式定位" },
    { "id": "monsters", "z": 80, "required": false, "description": "怪物，由程式生成與定位" },
    { "id": "player", "z": 90, "required": false, "description": "玩家角色，由遊戲程式渲染" },
    { "id": "effects", "z": 100, "required": false, "description": "陰影、特效、互動提示" }
  ],
  "adjacencyRules": {
    "terrain": "相鄰 Tile 的地面類型可以不同，但不能出現硬直線斷層；使用 transition 邊緣素材",
    "water": "河流與湖泊的水面、岸線必須在 Tile 邊界連續；水流方向由相鄰 Tile 一起定義",
    "paths": "道路中心線必須在邊界精確對齊；曲線與十字路口不得在 Tile 邊界突然中斷",
    "nature": "大型樹木與岩石可跨 Tile；禁止依賴 Tile 邊界裁切物件",
    "buildings": "建築可跨 Tile，但建築本體必須存在於單一 placement 資料中",
    "transparentLayers": "nature/buildings/objects/npcs/monsters/player/effects 使用透明背景",
    "edgeContract": "每個 Tile 定義 north/east/south/west 的 edge tags；相鄰邊必須相容"
